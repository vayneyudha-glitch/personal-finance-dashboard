# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=personal_finance
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# Admin Account (created by seed system)
ADMIN_EMAIL=vayneyudha@gmail.com
ADMIN_PASSWORD=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# OTP Provider (verification)
# Options: email (DEFAULT — OTP sent via SMTP email), console (dev only)
# Note: WhatsApp and SMS are NO LONGER used as OTP channels.
# WhatsApp webhook remains active for Meta integration but not for OTP delivery.
# In "console" mode with NODE_ENV=development, OTP is printed to the server terminal.
# In production, set OTP_PROVIDER=email and configure SMTP variables below.
OTP_PROVIDER=email

# ============================================================
# SMTP Email Service (for OTP delivery)
# Required when OTP_PROVIDER=email
# Use Nodemailer-compatible SMTP settings.
#
# Common SMTP configurations:
#   Gmail:     SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#   Outlook:  SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587, SMTP_SECURE=false
#   SSL:      SMTP_PORT=465, SMTP_SECURE=true
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Personal Finance Dashboard

# ============================================================
# WhatsApp Business Cloud API (Meta)
# Official docs: https://developers.facebook.com/docs/whatsapp/cloud-api
# Steps to get credentials:
#   1. Create a Meta Business account: https://business.facebook.com
#   2. Add WhatsApp to your Business portfolio
#   3. Add a phone number and get the Phone Number ID
#   4. Create a System User and generate an access token
#   5. Create and submit a message template for approval
#   6. Fill in the values below (webhook config only — NOT used for OTP delivery)
# Note: WhatsApp is NO LONGER used as OTP channel. Use OTP_PROVIDER=email.
# ============================================================
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id

# ============================================================
# WhatsApp Meta Webhook
# Official docs: https://developers.facebook.com/docs/whatsapp/cloud-api/webhooks
#
# WHATSAPP_WEBHOOK_VERIFY_TOKEN:
#   A random string YOU choose. Set the same value in the Meta
#   App Dashboard → WhatsApp → Configuration → Callback URL.
#   Used during the GET verification handshake.
#
# WHATSAPP_APP_SECRET:
#   Found in Meta App Dashboard → App Settings → Basic → App Secret.
#   Used to verify X-Hub-Signature-256 on POST webhook events.
# ============================================================
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_this_to_a_random_secret
WHATSAPP_APP_SECRET=

# Session protection
# When "true", logout invalidates the JWT server-side via token_blacklist table
SESSION_INVALIDATE_ON_LOGOUT=true
